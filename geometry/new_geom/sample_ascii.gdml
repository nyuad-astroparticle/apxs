<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./schema/gdml.xsd">

    <!-- <define>
        <position name="sample_ascii_v0" unit="mm" x="-145.5185" y="-177.6866" z="-138.8537"/>
        <position name="sample_ascii_v1" unit="mm" x="-95.51854" y="-224.8463" z="-138.8665"/>
        <position name="sample_ascii_v2" unit="mm" x="-145.5032" y="-177.6866" z="-78.85368"/>
        <position name="sample_ascii_v3" unit="mm" x="-95.50317" y="-224.8463" z="-78.86649"/>
        <position name="sample_ascii_v4" unit="mm" x="-95.51854" y="-177.6866" z="-138.8665"/>
        <position name="sample_ascii_v5" unit="mm" x="-95.50317" y="-177.6866" z="-78.86649"/>
    </define> -->

    <!-- <define> -->
        <!-- Adjustable offset for the sample Y coordinates -->
        <!-- <variable name="dist" value="7.50"/> -->

        <!-- <position name="sample_ascii_v0" unit="mm" x="-145.5185" y="-129.1290 - dist" z="-138.8537"/> -->
        <!-- <position name="sample_ascii_v1" unit="mm" x="-95.51854" y="-176.2887 - dist" z="-138.8665"/> -->
        <!-- <position name="sample_ascii_v2" unit="mm" x="-145.5032" y="-129.1290 - dist" z="-78.85368"/> -->
        <!-- <position name="sample_ascii_v3" unit="mm" x="-95.50317" y="-176.2887 - dist" z="-78.86649"/> -->
        <!-- <position name="sample_ascii_v4" unit="mm" x="-95.51854" y="-129.1290 - dist" z="-138.8665"/> -->
        <!-- <position name="sample_ascii_v5" unit="mm" x="-95.50317" y="-129.1290 - dist" z="-78.86649"/> -->
    <!-- </define> -->

     <define>
         <!-- Adjustable offset for the sample Y coordinates (adjusting this moves the sample away from the detector plane)-->
        <variable name="dist" value="20.00" />

        <!-- Center of the sample in the x, y, z coordinates -->
        <variable name="x_cen" value="-112.1852" />
        <variable name="y_cen" value="-174.8489" />
        <variable name="z_cen" value="-108.8537" />

        <!-- Rotation angle in degrees for Z-rotation -->
        <variable name="degrees" value="45.0" />
        <variable name="sin_theta" value="sin(degrees*deg)" />
        <variable name="cos_theta" value="cos(degrees*deg)" />

         <!-- Rotate sample vertices around Z using (x_cen, y_cen) as pivot; z unchanged -->
        <position name="sample_ascii_v0" unit="mm"
            x="(-145.5185 - x_cen)*cos_theta - ((-129.1290 - dist) - y_cen)*sin_theta + x_cen"
            y="(-145.5185 - x_cen)*sin_theta + ((-129.1290 - dist) - y_cen)*cos_theta + y_cen"
            z="-138.8537"/>
        <position name="sample_ascii_v1" unit="mm"
            x="(-95.51854 - x_cen)*cos_theta - ((-176.2887 - dist) - y_cen)*sin_theta + x_cen"
            y="(-95.51854 - x_cen)*sin_theta + ((-176.2887 - dist) - y_cen)*cos_theta + y_cen"
            z="-138.8665"/>
        <position name="sample_ascii_v2" unit="mm"
            x="(-145.5032 - x_cen)*cos_theta - ((-129.1290 - dist) - y_cen)*sin_theta + x_cen"
            y="(-145.5032 - x_cen)*sin_theta + ((-129.1290 - dist) - y_cen)*cos_theta + y_cen"
            z="-78.85368"/>
        <position name="sample_ascii_v3" unit="mm"
            x="(-95.50317 - x_cen)*cos_theta - ((-176.2887 - dist) - y_cen)*sin_theta + x_cen"
            y="(-95.50317 - x_cen)*sin_theta + ((-176.2887 - dist) - y_cen)*cos_theta + y_cen"
            z="-78.86649"/>
        <position name="sample_ascii_v4" unit="mm"
            x="(-95.51854 - x_cen)*cos_theta - ((-129.1290 - dist) - y_cen)*sin_theta + x_cen"
            y="(-95.51854 - x_cen)*sin_theta + ((-129.1290 - dist) - y_cen)*cos_theta + y_cen"
            z="-138.8665"/>
        <position name="sample_ascii_v5" unit="mm"
            x="(-95.50317 - x_cen)*cos_theta - ((-129.1290 - dist) - y_cen)*sin_theta + x_cen"
            y="(-95.50317 - x_cen)*sin_theta + ((-129.1290 - dist) - y_cen)*cos_theta + y_cen"
            z="-78.86649"/>
    
    </define>

    <materials>
    <!-- Define a rock-like mixture by NUMBER OF ATOMS (atomic %) -->
        <!-- <material name="rock1material" state="solid">
            <D value="2.65" unit="g/cm3"/>
            <T value="293.15" unit="K"/>
            <P value="1" unit="bar"/> -->

            <!-- Atomic % from your table (elements with 0% omitted) -->
            <!-- <fraction n="0.420806" ref="G4_C"/>
            <fraction n="0.307048" ref="G4_O"/>
            <fraction n="0.046215" ref="G4_Al"/>
            <fraction n="0.128145" ref="G4_Si"/>
            <fraction n="0.027171" ref="G4_K"/>
            <fraction n="0.070615" ref="G4_Ca"/> -->
        <!-- </material> -->

        <!-- Howlite material copied from DetectorConstruction.cc mass fractions -->
        <!-- <material name="Howlite" state="solid">
            <D value="2.58" unit="g/cm3"/>
            <T value="293.15" unit="K"/>
            <P value="1" unit="bar"/>
            <fraction n="0.5723899" ref="G4_O"/>
            <fraction n="0.2048364" ref="G4_Ca"/>
            <fraction n="0.1381232" ref="G4_B"/>
            <fraction n="0.0717717" ref="G4_Si"/>
            <fraction n="0.0128788" ref="G4_H"/>
        </material> -->

        <material name = "FerroanNoriticAnorthosite" state="solid">
            <D value="3.0" unit="g/cm3"/>
            <T value="293.15" unit="K"/>
            <P value="1" unit="bar"/>
            <fraction n="0.4497951" ref="G4_O"/>
            <fraction n="0.2070582" ref="G4_Si"/>
            <fraction n="0.1572021" ref="G4_Al"/>
            <fraction n="0.0310920" ref="G4_Fe"/>
            <fraction n="0.0004647" ref="G4_Mn"/>
            <fraction n="0.0229140" ref="G4_Mg"/>
            <fraction n="0.1236431" ref="G4_Ca"/>
            <fraction n="0.0015580" ref="G4_Na"/>
            <fraction n="0.0001328" ref="G4_K"/>
            <fraction n="0.0004600" ref="G4_Cr"/>
            <fraction n="0.0001500" ref="G4_Sr"/>
        </material>

        <!-- <material name = "Calcium" state="solid">
            <D value="3.0" unit="g/cm3"/>
            <T value="293.15" unit="K"/>
            <P value="1" unit="bar"/>
            <fraction n="1.0" ref="G4_Ca"/>
        </material> -->

    </materials>


    <solids>
        <tessellated aunit="deg" lunit="mm" name="sample_ascii-SOL">
             <triangular vertex1="sample_ascii_v0" vertex2="sample_ascii_v1" vertex3="sample_ascii_v2"/>
             <triangular vertex1="sample_ascii_v2" vertex2="sample_ascii_v1" vertex3="sample_ascii_v3"/>
             <triangular vertex1="sample_ascii_v1" vertex2="sample_ascii_v4" vertex3="sample_ascii_v3"/>
             <triangular vertex1="sample_ascii_v3" vertex2="sample_ascii_v4" vertex3="sample_ascii_v5"/>
             <triangular vertex1="sample_ascii_v4" vertex2="sample_ascii_v0" vertex3="sample_ascii_v5"/>
             <triangular vertex1="sample_ascii_v5" vertex2="sample_ascii_v0" vertex3="sample_ascii_v2"/>
             <triangular vertex1="sample_ascii_v2" vertex2="sample_ascii_v3" vertex3="sample_ascii_v5"/>
             <triangular vertex1="sample_ascii_v1" vertex2="sample_ascii_v0" vertex3="sample_ascii_v4"/>
        </tessellated>
    </solids>

    <structure>
        <volume name="sample_ascii">
            <materialref ref="FerroanNoriticAnorthosite"/>
            <solidref ref="sample_ascii-SOL"/>
            <auxiliary auxtype="Color" auxvalue="0.607 0.521 0.235"/>
            <auxiliary auxtype="opacity" auxvalue="1"/>
        </volume>
    </structure>

    <setup name="Default" version="1.0">
        <world ref="sample_ascii"/>
    </setup>
</gdml>
