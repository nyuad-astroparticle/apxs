<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./schema/gdml.xsd">

    <define>
        <rotation name="total_rotation" x="90" y="0" z="0" unit="degree"/> 
    </define>

    <materials>

    </materials>

    <solids>
        <box lunit="mm" name="world_solid" x="10000.0" y="10000.0" z="10000.0" />
    </solids>

    <structure>
        <volume name="world_volume">
            <materialref ref="G4_Galactic"/>
            <solidref ref="world_solid"/>

            <physvol>
                <file name="./geometry/new_geom/steel_ascii.gdml"/>
                <rotationref ref="total_rotation"/>
             </physvol>
            <physvol>
                <file name="./geometry/new_geom/aluminum_ascii.gdml"/>
                <rotationref ref="total_rotation"/>
             </physvol>
            <physvol>
                <file name="./geometry/new_geom/sdd_ascii.gdml"/>
                <rotationref ref="total_rotation"/>
             </physvol>
            <physvol>
                <file name="./geometry/new_geom/sample_ascii.gdml"/>
                <rotationref ref="total_rotation"/>
             </physvol>
            <physvol>
                <file name="./geometry/new_geom/source_ascii.gdml"/>
                <rotationref ref="total_rotation"/>
             </physvol>


        </volume>
    </structure>

    <setup name="Default" version="1.0">
        <world ref="world_volume"/>
    </setup>
</gdml>