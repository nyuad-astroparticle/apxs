<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./schema/gdml.xsd">

<materials>
    <material name="CuAlAlloy" state="solid">
        <density value="8.0" unit="g/cm3"/>
        <fraction n="0.9" ref="G4_Cu"/>
        <fraction n="0.1" ref="G4_Al"/>
        <T value="293.15" unit="K"/>
        <P value="1" unit="bar"/>
    </material>
</materials>

<solids>
    <box name="CalibrationPlate" lunit="mm" x="100." y="100." z="10."/>
</solids>

<structure>
    <volume name="PlateVolume">
        <materialref ref="CuAlAlloy"/>
        <solidref ref="CalibrationPlate"/>
        <auxiliary auxtype="Color" auxvalue="0.607 0.521 0.235"/>
        <auxiliary auxtype="opacity" auxvalue="1"/>
    </volume>
</structure>

<setup name="Default" version="1.0">
    <world ref="PlateVolume"/>
</setup>

</gdml>
