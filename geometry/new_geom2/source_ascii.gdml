<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="./schema/gdml.xsd">

  <solids>
    <tube name="source_solid" rmin="0" rmax="1.75" z="0.01"
          startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
  </solids>

  <structure>
    <volume name="source_ascii">
      <materialref ref="G4_Galactic"/>
      <solidref ref="source_solid"/>
      <auxiliary auxtype="Color" auxvalue="0 1 0"/>
      <auxiliary auxtype="opacity" auxvalue="1"/>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="source_ascii"/>
  </setup>
</gdml>
